
{
  "name": "vr-tech-solutions",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "python_workers"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vrtech-db",
